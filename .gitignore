# Dependências
node_modules/

# Ambiente / segredos
.env
.env.*
!.env.example

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Backup externo (fora do repo)
scripts/_tmp-*.json
scripts/_tmp-*.js

# Cursor
.cursor/

# Logs e temporários
*.log
npm-debug.log*
.cache/

# Uploads locais (produção usa Netlify Blobs)
uploads/*
!uploads/.gitkeep

# Base de dados SQLite local
data/
!data/.gitkeep
!data/backups/.gitkeep

# Sessões e dados de utilizador locais (não versionar)
content/sessions.json
content/users.json
content/user-sessions.json
content/oauth-states.json

# Android TWA (Play Store) — chaves e build local
deploy/android/bubblewrap-project/
deploy/android/*.keystore
deploy/android/*.jks
deploy/android/*.pepk
deploy/android/.keystore-password
deploy/android/keystore.password.txt

# JDK / tooling local (não versionar)
tools/jdk-*/
tools/*.zip

# Scripts temporários de download/pesquisa
scripts/tmp-*
scripts/tmp-*/

# Fontes de imagem temporárias
imagens/**/_src/

# Local Netlify folder
.netlify

# Cloudflare Pages / Wrangler
.wrangler/
.dev.vars
