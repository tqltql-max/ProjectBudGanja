    {
      "id": "poesia-palavra",
      "order": 4,
      "open": true,
      "title": "Poesia · método da palavra",
      "summary": "Poeminhas originais BudGanja no espírito do método da palavra (Gregorio) — legais e instantâneos.",
      "lessons": [
        {
          "id": "poesia-gregorio",
          "title": "Poesia e a língua",
          "exercises": [
            {
              "type": "read_pass",
              "promptKey": "promptRead",
              "prompt": "Leia o poeminho — depois continue.",
              "kicker": "Poesia · método da palavra",
              "title": "A palavra acorda",
              "lines": [
                "A palavra acorda cedo,",
                "veste sol e vai ao chão.",
                "Se você olhar com cuidado,",
                "ela vira investigação."
              ],
              "credit": "Poeminho original BudGanja · inspirado no método da palavra de Gregorio Duvivier",
              "legal": "Texto educacional nosso — não é poema publicado do autor. Os livros dele estão nas livrarias; aqui praticamos a ideia com conteúdo legal.",
              "linkHref": "/posts/post-inspecao-figura-duvivier.html",
              "linkLabel": "Abrir inspeção: Gregorio Duvivier"
            },
            {
              "type": "translate_mc",
              "promptKey": "promptTranslate",
              "pt": "palavra",
              "optionsEn": ["word", "plant", "seed"],
              "optionsEs": ["palabra", "planta", "semilla"],
              "answer": 0
            },
            {
              "type": "tap_word",
              "promptKey": "promptTap",
              "sentencePt": "A ___ acorda cedo no poema.",
              "blankToken": "___",
              "optionsPt": ["palavra", "raiva", "chapéu"],
              "answerPt": "palavra",
              "hintEn": "The word wakes up early in the poem.",
              "hintEs": "La palabra despierta temprano en el poema."
            },
            {
              "type": "match_pairs",
              "promptKey": "promptMatch",
              "pairs": [
                { "pt": "poesia", "en": "poetry", "es": "poesía" },
                { "pt": "língua", "en": "language", "es": "lengua" },
                { "pt": "cuidado", "en": "care", "es": "cuidado" }
              ]
            },
            {
              "type": "read_pass",
              "promptKey": "promptRead",
              "prompt": "Mais um poeminho curto — leia e continue.",
              "kicker": "Poesia · laboratório",
              "title": "Folha e verso",
              "lines": [
                "Folha verde, verso leve,",
